# Режим работы: mock или live
GIS_MODE=mock

# Базовый URL True API ГИС МТ (prod)
GIS_BASE_URL=https://markirovka.crpt.ru

# Административный ключ для доступа к /admin/*
# В production замените на сильный случайный ключ (secrets.token_urlsafe(36)).
ADMIN_KEY=change-me

# Товарные группы для поиска (cises/search требует filter.productGroups).
# Радиоэлектронная продукция = "radio". Можно несколько через запятую.
PRODUCT_GROUPS=radio

# Список организаций. Формат: INN=Название, разделённые ';'
ORGANIZATIONS=0000000001=ООО "ОРГАНИЗАЦИЯ 1";0000000002=ООО "ОРГАНИЗАЦИЯ 2";0000000003=ООО "ОРГАНИЗАЦИЯ 3";0000000004=ООО "ОРГАНИЗАЦИЯ 4"

# Путь к файлу токенов (по умолчанию data/tokens.json)
TOKENS_FILE=data/tokens.json