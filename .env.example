# Режим работы: mock или live
GIS_MODE=mock

# Базовый URL True API ГИС МТ (prod)
GIS_BASE_URL=https://markirovka.crpt.ru

# Административный ключ для доступа к /admin/*
# В production замените на сильный случайный ключ (secrets.token_urlsafe(36)).
ADMIN_KEY=change-me

# Товарные группы для поиска (cises/search требует filter.productGroups).
# Радиоэлектронная продукция = "radio". Можно несколько через запятую.
PRODUCT_GROUPS=radio

# Список организаций. Формат: INN=Название, разделённые ';'
ORGANIZATIONS=0000000001=ООО "ОРГАНИЗАЦИЯ 1";0000000002=ООО "ОРГАНИЗАЦИЯ 2";0000000003=ООО "ОРГАНИЗАЦИЯ 3";0000000004=ООО "ОРГАНИЗАЦИЯ 4"

# Путь к файлу токенов (по умолчанию data/tokens.json)
TOKENS_FILE=data/tokens.json
# Durable warehouse documents (local disk, preserve across deploys)
# WAREHOUSE_DB=data/warehouse.sqlite3
# Default receiving organization, must exist in ORGANIZATIONS
# RECEIPT_DEFAULT_ORG=0000000001

# Персональные ссылки кабинета ОП. Пустой JSON отключает кабинет.
# Для каждого логина используйте отдельный ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
SALES_SHIPMENT_LINKS={}

# Отдельный ключ создания черновиков приёмки из marking-bm (пусто — отключено).
RECEIPT_BRIDGE_KEY=

# Общий Windows-подписант (сертификат тот же, что у Marking-BM).
# Отдельный секрет подключения GIS True API; введите его при запуске Start-Signer.ps1.
GIS_SIGNER_TOKEN=
GIS_SIGNER_THUMBPRINT=

# Автоматическое разделение КМ через отдельный сервис km-split.
KM_SPLIT_URL=https://km-split.internal.example
# Должен совпадать с SPLIT_INTERNAL_TOKEN на сервере km-split.
KM_SPLIT_INTERNAL_TOKEN=

# Доступ SQL-интеграции к XML-проверке КИ. Ключ и ИНН задаются вместе.
CIS_CHECK_KEY=
CIS_CHECK_ORG_INN=
